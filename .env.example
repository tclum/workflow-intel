# workflow-intel — environment

# Postgres (REQUIRED) — connection string for migrations + queries.
# NOTE: migration 0001 is UNAPPLIED in Slice 0. Set this only when you have
# reviewed src/db/migrations/0001_init.sql and are ready to apply it yourself.
DATABASE_URL=postgresql://user:pass@localhost:5432/workflow_intel

NODE_ENV=development
LOG_LEVEL=info

# Slice 1.5 (email-newsletter ingestion) — IMAP poll of a dedicated Gmail
# (projectcatchall73@gmail.com) using an app-password. Each email source is a
# Gmail label exposed as an IMAP folder (see config/sources.yaml). Leave USER /
# PASSWORD blank for RSS-only ingest; the email fetcher requires them at run time.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# --- Reserved for later slices; unused in Slices 0-1 (no API calls made). ---

# Slice 2 (semantic dedup) — Voyage embeddings, voyage-3 -> VECTOR(1024).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Slice 3 (triage) + Slice 4 (synthesis) — Anthropic. Defaults below are
# placeholders; confirm the exact model id before wiring those slices.
ANTHROPIC_API_KEY=
ANTHROPIC_TRIAGE_MODEL=claude-haiku-4-5
ANTHROPIC_SYNTHESIS_MODEL=claude-opus-4-8
