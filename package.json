{
  "name": "workflow-intel",
  "version": "0.1.0",
  "private": true,
  "description": "Private-first AI workflow & token-efficiency intelligence pipeline (Slices 0-1: store + ingestion).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx src/ingest/run.ts",
    "embed": "tsx scripts/embed.ts",
    "dedup": "tsx scripts/dedup.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "imapflow": "^1.4.0",
    "mailparser": "^3.9.9",
    "postgres": "^3.4.4",
    "rss-parser": "^3.13.0",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.10",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3",
    "vitest": "^1.6.0"
  }
}
